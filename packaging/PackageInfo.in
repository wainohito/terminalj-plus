name			terminalj_plus
version			@VERSION@
architecture	x86_64
summary			"Terminal with inline Japanese input"
description		"TerminalJ+ is the RenkuOS Terminal with inline input methods: text typed with Mozc and other input methods is composed and converted where the cursor is, not in a separate window. It lives next to Terminal, with its own settings."
packager		"RenkuOS"
vendor			"RenkuOS"
copyrights		{
	"2001-2026 Haiku, Inc."
	"2026 RenkuOS contributors"
}
licenses		{
	"MIT"
}
flags			{
}
provides		{
	terminalj_plus = @VERSION@
	app:TerminalJ+ = @VERSION@
}
requires		{
	haiku
	lib:libstdc++
}
